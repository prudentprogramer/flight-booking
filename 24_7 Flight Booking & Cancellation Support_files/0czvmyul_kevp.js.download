  src: url('${e}/fonts/EudoxusSans-Light.woff2') format('woff2'),
    url('${e}/fonts/EudoxusSans-Light.woff') format('woff');
  font-weight: 300;
  font-style: normal;
  font-display: block;
}
@font-face {
  font-family: 'Eudoxus Sans';
  src: url('${e}/fonts/EudoxusSans-ExtraBold.woff2') format('woff2'),
    url('${e}/fonts/EudoxusSans-ExtraBold.woff') format('woff');
