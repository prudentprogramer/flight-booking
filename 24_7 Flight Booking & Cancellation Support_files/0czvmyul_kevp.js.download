  query SearchMention(
    $workspaceId: ID!
    $query: String!
    $types: [SearchType!] = [user, doc]
  ) {
    search(orgId: $workspaceId, query: $query, types: $types) {
      __typename
      ... on DocResult {
        ...DocResultFragment
      }
      ... on User {
        id
        displayName
        email
        profileImageUrl
      }
    }
  }
`;let U=W.gql`
