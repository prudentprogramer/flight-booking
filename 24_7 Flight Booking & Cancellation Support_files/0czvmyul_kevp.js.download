  @keyframes sparkle-large {
    0%, 20%, 80%, 100% { 
      transform: scale(1.1);
    }
    50% { 
      transform: scale(0.9);
    }
  }

  @keyframes sparkle-small {
    0%, 20%, 80%, 100% { 
      transform: scale(1.2);
    }
    50% { 
      transform: scale(1);
    }
  }

  @keyframes sparkle-dot-top {
    0%, 20%, 80%, 100% { 
      transform: scale(1.1) translateX(0px);
    }
    50% { 
      transform: scale(0.9) translateX(0.5px);
    }
  }

  @keyframes sparkle-dot-bottom {
    0%, 20%, 80%, 100% { 
      transform: scale(1.1) translateX(0.5px);
    }
    50% { 
      transform: scale(0.9) translateX(0px);
